{
  "manifest_version": 3,
  "name": "cozy job tracker",
  "description": "Add jobs to your board with one click",
  "version": "1.0.0",
  "permissions": ["activeTab", "cookies", "storage"],
  "host_permissions": ["https://cozyjobtracker.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
